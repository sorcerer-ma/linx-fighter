@@ -0,0 +1,381 @@
+// 战斗 HUD 渲染层：8 表情、生命条、5 闪电能量、大招徽记三态
+#include "battle_hud.h"
+#include "battle_assets.h"
+
+#include "application.h"
+#include "board.h"
+#include "display.h"
+#include "assets/lang_config.h"
+
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <optional>
+#include <string_view>
+
+namespace {
+constexpr char TAG[] = "BattleHud";
+
+// 表情名 -> 预渲染位图（经验：位图比图元更贴近设计稿，且 320x240 下无锯齿）
+struct ExpressionEntry {
+    const char *name;
+    const lv_image_dsc_t *image;
+};
+constexpr ExpressionEntry kExpressions[] = {
+    {"neutral", &face_neutral}, {"attack", &face_attack},   {"hurt", &face_hurt},
+    {"guard", &face_guard},     {"dodge", &face_dodge},     {"ultready", &face_ultready},
+    {"victory", &face_victory}, {"defeat", &face_defeat},
+};
+
+// 颜色沿用移动端原型（docs/product/prototypes/mobile-companion.html）
+constexpr uint32_t kHpTrackColor = 0x223A2C;
+constexpr uint32_t kHpColor = 0x7FC98A;
+constexpr uint32_t kHpLowColor = 0xE0A34A;
+
+lv_obj_t *root_ = nullptr;
+lv_obj_t *face_image_ = nullptr;
+lv_obj_t *hp_fill_ = nullptr;
+lv_obj_t *energy_icons_[5] = {};
+lv_obj_t *ult_image_ = nullptr;
+lv_timer_t *hold_timer_ = nullptr;
+
+char current_expression_[16] = "neutral";
+char current_cue_[16] = "";
+int current_hp_ = 10;
+int current_max_hp_ = 10;
+int current_energy_ = 0;
+int current_max_energy_ = 5;
+int current_ult_ = 0;
+int current_seq_ = -1;
+int current_hold_ms_ = 0;
+bool locked_ = false;
+
+// LVGL 只在持有显示锁时访问；串口任务与主任务共用同一把递归锁
+// 显示对象由 battle_hud_create() 显式注入：板级构造期间 Board 单例仍处于
+// 初始化中，此时再调用 Board::GetInstance() 会递归等待静态初始化保护而挂死。
+Display* g_display = nullptr;
+
+class HudLock {
+public:
+    HudLock() {
+        if (g_display != nullptr) {
+            guard_.emplace(g_display);
+        }
+    }
+
+private:
+    std::optional<DisplayLockGuard> guard_;
+};
+
+int Clamp(int value, int low, int high) {
+    return value < low ? low : (value > high ? high : value);
+}
+
+const lv_image_dsc_t *FindExpression(const char *name) {
+    if (name == nullptr) {
+        return &face_neutral;
+    }
+    for (const auto &entry : kExpressions) {
+        if (strcmp(entry.name, name) == 0) {
+            return entry.image;
+        }
+    }
+    return nullptr;
+}
+
+void ApplyExpression(const char *name) {
+    const lv_image_dsc_t *image = FindExpression(name);
+    if (image == nullptr || face_image_ == nullptr) {
+        ESP_LOGW(TAG, "unknown expression: %s", name ? name : "(null)");
+        return;
+    }
+    lv_image_set_src(face_image_, image);
+    snprintf(current_expression_, sizeof(current_expression_), "%s", name);
+}
+
+void ApplyResources() {
+    if (hp_fill_ == nullptr) {
+        return;
+    }
+    // 生命条：按比例填充，低血量改用琥珀色，不显示数字
+    const int width = 172;  // 轨道内可视宽度
+    int ratio_hp = current_max_hp_ > 0 ? Clamp(current_hp_ * 100 / current_max_hp_, 0, 100) : 0;
+    int fill_width = width * ratio_hp / 100;
+    lv_obj_set_width(hp_fill_, fill_width);
+    lv_obj_set_style_bg_color(hp_fill_,
+                              lv_color_hex(ratio_hp <= 30 ? kHpLowColor : kHpColor), 0);
+
+    // 能量：max_energy 个闪电，已有点亮，耗尽置灰
+    const int max_icons = static_cast<int>(sizeof(energy_icons_) / sizeof(energy_icons_[0]));
+    for (int i = 0; i < max_icons; ++i) {
+        if (energy_icons_[i] == nullptr) {
+            continue;
+        }
+        if (i < current_max_energy_) {
+            lv_obj_remove_flag(energy_icons_[i], LV_OBJ_FLAG_HIDDEN);
+            bool owned = i < current_energy_;
+            lv_image_set_src(energy_icons_[i], owned ? &icon_bolt_on : &icon_bolt_off);
+        } else {
+            lv_obj_add_flag(energy_icons_[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    // 大招徽记：0 空心断弧 / 1 实心完整弧+气焰 / 2 气焰消失+斜划
+    if (ult_image_ != nullptr) {
+        switch (current_ult_) {
+            case 1:
+                lv_image_set_src(ult_image_, &ult_ready);
+                break;
+            case 2:
+                lv_image_set_src(ult_image_, &ult_used);
+                break;
+            default:
+                lv_image_set_src(ult_image_, &ult_idle);
+                break;
+        }
+    }
+}
+
+void HoldTimerCallback(lv_timer_t *timer) {
+    (void)timer;
+    hold_timer_ = nullptr;
+    // 短时表情（受击/闪避）结束后回到待命，避免定格
+    ApplyExpression("neutral");
+}
+
+void ScheduleExpressionHold(int hold_ms) {
+    if (hold_timer_ != nullptr) {
+        lv_timer_delete(hold_timer_);
+        hold_timer_ = nullptr;
+    }
+    if (hold_ms <= 0) {
+        return;
+    }
+    hold_timer_ = lv_timer_create(HoldTimerCallback, hold_ms, nullptr);
+    lv_timer_set_repeat_count(hold_timer_, 1);
+}
+
+const std::string_view *FindCue(const char *cue) {
+    if (cue == nullptr) {
+        return nullptr;
+    }
+    // 兼容表情名与音效名两套写法：演示/服务端都按表情名下发
+    if (strcmp(cue, "neutral") == 0) return &Lang::Sounds::OGG_READY;
+    if (strcmp(cue, "ultready") == 0) return &Lang::Sounds::OGG_ULT;
+    if (strcmp(cue, "ready") == 0) return &Lang::Sounds::OGG_READY;
+    if (strcmp(cue, "attack") == 0) return &Lang::Sounds::OGG_ATTACK;
+    if (strcmp(cue, "hurt") == 0) return &Lang::Sounds::OGG_HURT;
+    if (strcmp(cue, "guard") == 0) return &Lang::Sounds::OGG_GUARD;
+    if (strcmp(cue, "dodge") == 0) return &Lang::Sounds::OGG_DODGE;
+    if (strcmp(cue, "ult") == 0) return &Lang::Sounds::OGG_ULT;
+    if (strcmp(cue, "victory") == 0) return &Lang::Sounds::OGG_VICTORY;
+    if (strcmp(cue, "defeat") == 0) return &Lang::Sounds::OGG_DEFEAT;
+    return nullptr;
+}
+}  // namespace
+
+void battle_hud_create(Display* display) {
+    g_display = display;
+    HudLock lock;
+    if (root_ != nullptr) {
+        return;
+    }
+
+    // HUD 根层：透明、不可点击，覆盖在隐藏后的原界面上
+    root_ = lv_obj_create(lv_screen_active());
+    lv_obj_set_size(root_, lv_display_get_horizontal_resolution(nullptr),
+                    lv_display_get_vertical_resolution(nullptr));
+    lv_obj_set_pos(root_, 0, 0);
+    lv_obj_set_style_bg_opa(root_, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(root_, 0, 0);
+    lv_obj_set_style_pad_all(root_, 0, 0);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_CLICKABLE);
+
+    // 表情：设计稿要求居中且占主要面积
+    face_image_ = lv_image_create(root_);
+    lv_obj_set_pos(face_image_, 40, 6);
+    lv_image_set_src(face_image_, &face_neutral);
+    // 显式给出尺寸：不依赖图片解码器回填，避免尺寸为 0 时完全不可见
+    lv_obj_set_size(face_image_, 240, 170);
+
+    // 生命条：爱心 + 绿色辅助条，不显示数值
+    lv_obj_t *heart = lv_image_create(root_);
+    lv_image_set_src(heart, &icon_heart);
+    lv_obj_set_pos(heart, 8, 188);
+
+    lv_obj_t *hp_track = lv_obj_create(root_);
+    lv_obj_set_size(hp_track, 176, 14);
+    lv_obj_set_pos(hp_track, 28, 188);
+    lv_obj_set_style_radius(hp_track, 7, 0);
+    lv_obj_set_style_bg_color(hp_track, lv_color_hex(kHpTrackColor), 0);
+    lv_obj_set_style_bg_opa(hp_track, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(hp_track, 0, 0);
+    lv_obj_set_style_pad_all(hp_track, 0, 0);
+    lv_obj_remove_flag(hp_track, LV_OBJ_FLAG_SCROLLABLE);
+
+    hp_fill_ = lv_obj_create(hp_track);
+    lv_obj_set_size(hp_fill_, 172, 10);
+    lv_obj_set_pos(hp_fill_, 2, 2);
+    lv_obj_set_style_radius(hp_fill_, 5, 0);
+    lv_obj_set_style_bg_color(hp_fill_, lv_color_hex(kHpColor), 0);
+    lv_obj_set_style_bg_opa(hp_fill_, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(hp_fill_, 0, 0);
+
+    // 能量：5 个闪电，与生命条并排一行
+    for (int i = 0; i < 5; ++i) {
+        energy_icons_[i] = lv_image_create(root_);
+        lv_image_set_src(energy_icons_[i], &icon_bolt_off);
+        lv_obj_set_pos(energy_icons_[i], 212 + i * 20, 188);
+    }
+
+    // 大招徽记：右上角，三态由服务端决定
+    ult_image_ = lv_image_create(root_);
+    lv_image_set_src(ult_image_, &ult_idle);
+    lv_obj_set_pos(ult_image_, 284, 4);
+
+    lv_obj_move_foreground(root_);
+    ApplyResources();
+    ESP_LOGI(TAG, "HUD created: 8 expressions, hp bar, 5 bolts, ult badge");
+
+    // 开机自检：3 秒后自动播放一遍 8 表情与对应音效（串口 hud.demo 可随时重放）
+    lv_timer_t *boot = lv_timer_create([](lv_timer_t *t) {
+        lv_timer_delete(t);
+        battle_demo_start();
+    }, 3000, nullptr);
+    if (boot != nullptr) {
+        lv_timer_set_repeat_count(boot, 1);
+    }
+}
+
+bool battle_hud_apply(const battle_hud_state_t *state) {
+    HudLock lock;
+    if (state == nullptr || root_ == nullptr) {
+        return false;
+    }
+    if (FindExpression(state->expression) == nullptr) {
+        return false;
+    }
+
+    locked_ = true;
+    ApplyExpression(state->expression);
+    current_hp_ = state->max_hp > 0 ? Clamp(state->hp, 0, state->max_hp) : 0;
+    current_max_hp_ = state->max_hp > 0 ? state->max_hp : 1;
+    current_max_energy_ = Clamp(state->max_energy, 0, 5);
+    current_energy_ = Clamp(state->energy, 0, current_max_energy_);
+    current_ult_ = Clamp(state->ult, 0, 2);
+    current_seq_ = state->seq;
+    current_hold_ms_ = state->hold_ms;
+    ApplyResources();
+    ScheduleExpressionHold(state->hold_ms);
+
+    if (state->cue != nullptr && state->cue[0] != '\0') {
+        battle_hud_play_cue(state->cue);
+    }
+    ESP_LOGI(TAG, "apply seq=%d expr=%s hp=%d/%d energy=%d/%d ult=%d cue=%s hold=%dms",
+             current_seq_, current_expression_, current_hp_, current_max_hp_, current_energy_,
+             current_max_energy_, current_ult_, state->cue ? state->cue : "-", state->hold_ms);
+    return true;
+}
+
+void battle_hud_set_expression(const char *expression, int hold_ms) {
+    HudLock lock;
+    if (locked_ || root_ == nullptr || expression == nullptr) {
+        return;
+    }
+    if (FindExpression(expression) == nullptr) {
+        return;
+    }
+    ApplyExpression(expression);
+    ScheduleExpressionHold(hold_ms);
+}
+
+void battle_hud_get_state_json(char *out, size_t out_len) {
+    if (out == nullptr || out_len == 0) {
+        return;
+    }
+    snprintf(out, out_len,
+             "{\"expression\":\"%s\",\"hp\":%d,\"max_hp\":%d,\"energy\":%d,\"max_energy\":%d,"
+             "\"ult\":%d,\"seq\":%d,\"cue\":\"%s\",\"hold_ms\":%d,\"locked\":%s}",
+             current_expression_, current_hp_, current_max_hp_, current_energy_,
+             current_max_energy_, current_ult_, current_seq_, current_cue_, current_hold_ms_,
+             locked_ ? "true" : "false");
+}
+
+void battle_hud_play_cue(const char *cue) {
+    const std::string_view *sound = FindCue(cue);
+    if (sound == nullptr) {
+        ESP_LOGW(TAG, "unknown cue: %s", cue ? cue : "(null)");
+        return;
+    }
+    snprintf(current_cue_, sizeof(current_cue_), "%s", cue);
+    // 走主任务调度，避免在 LVGL/串口任务里直接操作音频解码队列
+    Application::GetInstance().Schedule([sound]() {
+        Application::GetInstance().PlaySound(*sound);
+    });
+    ESP_LOGI(TAG, "cue=%s", cue);
+}
+
+bool battle_hud_is_locked() {
+    return locked_;
+}
+
+void battle_hud_unlock() {
+    HudLock lock;
+    locked_ = false;
+    ApplyExpression("neutral");
+    ESP_LOGI(TAG, "HUD unlocked");
+}
+
+// 截屏：把当前屏幕快照成 RGB565 裸数据，便于本机核对「设备实际渲染成什么样」
+bool battle_hud_snapshot(uint8_t **out, size_t *len, int *w, int *h) {
+    if (out == nullptr || len == nullptr || w == nullptr || h == nullptr) {
+        return false;
+    }
+    *out = nullptr;
+#if !LV_USE_SNAPSHOT
+    ESP_LOGW(TAG, "snapshot: LV_USE_SNAPSHOT 未开启");
+    return false;
+#endif
+    HudLock lock;
+    lv_display_t *disp = lv_display_get_default();
+    if (disp == nullptr) {
+        ESP_LOGW(TAG, "snapshot: no display");
+        return false;
+    }
+    int32_t width = lv_display_get_horizontal_resolution(disp);
+    int32_t height = lv_display_get_vertical_resolution(disp);
+    lv_draw_buf_t *buf = lv_draw_buf_create(width, height, LV_COLOR_FORMAT_RGB565, 0);
+    if (buf == nullptr) {
+        ESP_LOGW(TAG, "snapshot: draw buf create failed");
+        return false;
+    }
+    if (lv_snapshot_take_to_draw_buf(lv_screen_active(), LV_COLOR_FORMAT_RGB565, buf) != LV_RESULT_OK) {
+        lv_draw_buf_destroy(buf);
+        ESP_LOGW(TAG, "snapshot: take failed");
+        return false;
+    }
+    size_t row_bytes = static_cast<size_t>(width) * 2;
+    size_t bytes = row_bytes * height;
+    uint8_t *mem = static_cast<uint8_t *>(heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM));
+    if (mem == nullptr) {
+        mem = static_cast<uint8_t *>(heap_caps_malloc(bytes, MALLOC_CAP_DEFAULT));
+    }
+    if (mem == nullptr) {
+        lv_draw_buf_destroy(buf);
+        return false;
+    }
+    uint32_t stride = buf->header.stride != 0 ? buf->header.stride : row_bytes;
+    for (int32_t y = 0; y < height; y++) {
+        memcpy(mem + static_cast<size_t>(y) * row_bytes,
+               static_cast<uint8_t *>(buf->data) + static_cast<size_t>(y) * stride, row_bytes);
+    }
+    lv_draw_buf_destroy(buf);
+    *out = mem;
+    *len = bytes;
+    *w = width;
+    *h = height;
+    return true;
+}
