+// 一屏两行资源：上排=对面玩家，下排=自己；每行都是「爱心+数字+血条+5 闪电+数字」
+struct ResourceRow {
+    lv_obj_t *heart = nullptr;
+    lv_obj_t *hp_label = nullptr;
+    lv_obj_t *hp_track = nullptr;
