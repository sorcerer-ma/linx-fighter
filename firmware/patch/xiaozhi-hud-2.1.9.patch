+// MCP 工具：把平台智能体的调用映射到同一套 HUD 状态
+Property HudIntegerProperty(const char *name, int default_value, int min_value, int max_value) {
+    return Property(name, kPropertyTypeInteger, default_value, min_value, max_value);
+}
