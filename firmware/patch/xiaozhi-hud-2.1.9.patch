+int current_energy_ = 0;
+int current_max_energy_ = 5;
+int current_ult_ = 0;
+int current_seq_ = -1;
+int current_hold_ms_ = 0;
+bool locked_ = false;
+bool current_has_opponent_ = false;
+int current_opp_hp_ = 0;
+int current_opp_max_hp_ = 1;
+int current_opp_energy_ = 0;
