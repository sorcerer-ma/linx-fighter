+void battle_ctl_start() {
+    battle_mcp_register();
+    ESP_LOGI(TAG, "HUD MCP tools registered: self.hud.set_state / self.hud.get_state / self.hud.demo");
+    xTaskCreate(ControlTask, "battle_ctl", 8192, nullptr, 2, nullptr);
+}
