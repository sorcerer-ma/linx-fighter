+void LcdDisplay::ShowSystemUi(bool show) {
+    // 配网/激活这类系统界面用的是原始状态栏文字提示（热点名、浏览器地址等），
+    // 战斗 HUD 会盖住它们，所以这里让 HUD 暂时让位。
+    DisplayLockGuard lock(this);
+    lv_obj_t *bars[] = {status_bar_, top_bar_};
+    for (lv_obj_t *bar : bars) {
+        if (bar == nullptr) {
+            continue;
+        }
+        if (show) {
+            lv_obj_remove_flag(bar, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(bar, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    battle_hud_set_overlay_visible(!show);
+}
