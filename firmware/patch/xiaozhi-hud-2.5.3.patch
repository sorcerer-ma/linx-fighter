+// 单行 JSON 输出（MCP 响应不带 @@HUD 前缀，便于标准 MCP 客户端直接解析）
+void PrintJsonLine(cJSON *obj) {
+    char *text = cJSON_PrintUnformatted(obj);
+    if (text == nullptr) {
+        return;
+    }
+    std::string line(text);
+    line += '\n';
+    HudWrite(reinterpret_cast<const uint8_t *>(line.data()), line.size());
+    cJSON_free(text);
+}
