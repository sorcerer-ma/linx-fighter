+
+// 平台 emotion（小智 21 种）→ 表情视图的 12 张脸。
+// 设计口径：日常对话里用「吃惊/飞吻/思考/休眠」等表情，战斗结局复用胜利/失败。
+static const char* HudExpressionFromEmotion(const char* emotion) {
+    static const struct {
+        const char* emotion;
+        const char* face;
+    } kMap[] = {
+        {"surprised", "surprised"}, {"shocked", "surprised"},
+        {"kissy", "kiss"}, {"loving", "kiss"}, {"winking", "kiss"},
+        {"thinking", "thinking"}, {"confused", "thinking"},
+        {"sleepy", "sleep"},
+        {"happy", "victory"}, {"laughing", "victory"},
+        {"funny", "victory"}, {"delicious", "victory"},
+        {"sad", "defeat"}, {"crying", "defeat"},
+        {"embarrassed", "defeat"}, {"angry", "ultready"},
+    };
+    if (emotion == nullptr) {
+        return "neutral";
+    }
+    for (const auto& item : kMap) {
+        if (strcmp(emotion, item.emotion) == 0) {
+            return item.face;
+        }
+    }
+    return "neutral";
+}
