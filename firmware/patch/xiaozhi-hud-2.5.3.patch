+void battle_ctl_start() {
+    battle_mcp_register();
+    ESP_LOGI(TAG, "HUD MCP tools registered: set_state / get_state / demo / link");
+    xTaskCreate(ControlTask, "battle_ctl", 8192, nullptr, 2, nullptr);
+}
