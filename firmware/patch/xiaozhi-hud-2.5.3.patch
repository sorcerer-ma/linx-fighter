--- clean-v210/xiaozhi-esp32-2.1.0/main/display/battle_hud.h	1970-01-01 08:00:00
+++ fwsrc/xiaozhi-esp32-2.1.0/main/display/battle_hud.h	2026-11-01 00:09:03
@@ -0,0 +1,75 @@
+// 战斗 HUD：8 表情 + 生命条 + 5 闪电能量 + 大招徽记三态
+// 状态由服务端权威派生后通过 MCP / 串口命令下发，设备只负责渲染与提示音
+#pragma once
+
+#include <lvgl.h>
+
+#include "display.h"
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** 一次 HUD 展示快照（字段与外观一一对应，不含文字） */
+typedef struct {
+    const char *expression;  /* 表情名：neutral/attack/hurt/guard/dodge/ultready/victory/defeat */
+    bool battle;             /* 是否在战斗中；false 时只画表情，不画资源行与徽记 */
+    const char *mode;        /* 对局形态："pvp" 上排对手、下排自己；"solo" 上排自己；NULL 按 pvp */
+    int hp;
+    int max_hp;
+    int energy;
+    int max_energy;
+    int ult;                 /* 0=未就绪 1=可释放 2=本局已用 */
+    int seq;                 /* 状态序号，用于去重与补发判断 */
+    const char *cue;         /* 音效名，可为 NULL */
+    int hold_ms;             /* 表情保持时长（毫秒），0 表示常驻 */
+
+    /* 对面玩家（两块屏相对摆放：本设备显示「对手在上一行、自己在下一行」）。
+       没有对手（单人等待加入）时 has_opponent=false，上排整行隐藏。 */
+    bool has_opponent;
+    int opp_hp;
+    int opp_max_hp;
+    int opp_energy;
+    int opp_max_energy;
+    int opp_ult;             /* 0=未就绪 1=可释放 2=本局已用 */
+} battle_hud_state_t;
+
+/** 创建 HUD 层（在 LcdDisplay::SetupUI 末尾调用，沿用同一块屏幕） */
+// 传入 display：板级构造函数里 Board::GetInstance() 尚未就绪，不能反查单例
+void battle_hud_create(Display* display);
+
+/** 应用一次状态；返回 false 表示入参非法 */
+bool battle_hud_apply(const battle_hud_state_t *state);
+
+/** 设置表情（platform 情绪或临时表情用；HUD 接管后忽略） */
+void battle_hud_set_expression(const char *expression, int hold_ms);
+
+// 战斗 HUD 图层显隐：系统界面（配网/激活）需要整屏显示原始提示时隐藏
+void battle_hud_set_overlay_visible(bool visible);
+
+/** 当前状态导出为 JSON（供 hud.get_state 与 MCP 工具返回） */
+void battle_hud_get_state_json(char *out, size_t out_len);
+
+/** 播报音效名对应的内置 ogg */
+void battle_hud_play_cue(const char *cue);
+
+/** 是否已由战斗状态接管显示（接管后忽略平台情绪） */
+bool battle_hud_is_locked(void);
+
+/** 解除接管：回到待命表情，恢复平台情绪可用 */
+void battle_hud_unlock(void);
+
+/** 启动串口命令通道（USB Serial/JTAG，JSON-RPC 风格） */
+// 截取当前屏幕为 RGB565 位图；成功时 *out 需调用方 heap_caps_free 释放
+bool battle_hud_snapshot(uint8_t **out, size_t *len, int *w, int *h);
+void battle_ctl_start(void);
+// 异步启动 8 表情/音效演示（开机自检与 hud.demo 共用）
+void battle_demo_start(void);
+// 注册 self.hud.* 设备 MCP 工具（由 battle_ctl_start 调用）
+void battle_mcp_register(void);
+
+#ifdef __cplusplus
+}
+#endif
diff -ruN --exclude=build --exclude=managed_components --exclude=components --exclude=sdkconfig --exclude=face_assets.c --exclude=lang_config.h clean-v210/xiaozhi-esp32-2.1.0/main/display/battle_link.cc fwsrc/xiaozhi-esp32-2.1.0/main/display/battle_link.cc
--- clean-v210/xiaozhi-esp32-2.1.0/main/display/battle_link.cc	1970-01-01 08:00:00
+++ fwsrc/xiaozhi-esp32-2.1.0/main/display/battle_link.cc	2026-11-01 00:11:11
@@ -0,0 +1,223 @@
+// 战斗 HUD 推送接收（HudLink）
+// 与拉取版（battle_pull）共用同一份 HUD 解析：帧号去重、battle_hud 渲染、cue 播音效。
+// 设备端只维护一条长连接，断线后退避重连；网络没就绪时先等着，避免在 lwIP 起来前发包。
+#include "battle_link.h"
+
+#include "application.h"
+#include "battle_hud.h"
+#include "battle_pull.h"
+#include "board.h"
+#include "settings.h"
+
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <cstdio>
+#include <memory>
+#include <cstring>
+#include <string>
+
+namespace {
+constexpr char TAG[] = "BattleLink";
+
+// 与拉取通道共用 NVS 命名空间，另存一套键，互不覆盖
+constexpr char kNamespace[] = "hud";
+constexpr char kKeyUrl[] = "ws_url";
+constexpr char kKeyEnabled[] = "ws_on";
+
+constexpr int kTickMs = 200;        // 主循环节拍：检查连接状态与保活
+constexpr int kRetryMs = 3000;      // 断线重连间隔
+constexpr int kPingMs = 20000;      // 保活间隔，低于服务端 25s 心跳
+constexpr int kWaitNetworkMs = 800; // 网络没就绪时的等待
+
+struct LinkConfig {
+    std::string url;
+    bool enabled = false;
+};
+
+// 设备身份用 WiFi STA MAC，与服务端 deviceId 口径一致
+std::string DeviceMac() {
+    uint8_t mac[6] = {};
+    if (esp_read_mac(mac, ESP_MAC_WIFI_STA) != ESP_OK) {
+        return {};
+    }
+    char buffer[18];
+    std::snprintf(buffer, sizeof(buffer), "%02x:%02x:%02x:%02x:%02x:%02x",
+                  mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+    return buffer;
+}
+
+// 地址没带 device 参数时补上，服务端据此找这台设备的对局
+std::string WithDevice(const std::string &url) {
+    if (url.find("device=") != std::string::npos) {
+        return url;
+    }
+    const std::string mac = DeviceMac();
+    if (mac.empty()) {
+        return url;
+    }
+    return url + (url.find('?') == std::string::npos ? "?" : "&") + "device=" + mac;
+}
+
+LinkConfig LoadConfig() {
+    Settings settings(kNamespace, false);
+    LinkConfig config;
+    config.url = settings.GetString(kKeyUrl, "");
+    config.enabled = settings.GetBool(kKeyEnabled, false);
+    return config;
+}
+
+bool SaveConfig(const std::string &url, bool enabled) {
+    Settings settings(kNamespace, true);
+    settings.SetString(kKeyUrl, url);
+    settings.SetBool(kKeyEnabled, enabled);
+    return true;
+}
+
+// 设备状态机没到「可联网」之前不建连：与拉取通道同一道闸
+bool NetworkReady() {
+    auto state = Application::GetInstance().GetDeviceState();
+    switch (state) {
+        case kDeviceStateStarting:
+        case kDeviceStateWifiConfiguring:
+        case kDeviceStateActivating:
+        case kDeviceStateUpgrading:
+            return false;
+        default:
+            return true;
+    }
+}
+
+struct LinkRuntime {
+    std::unique_ptr<WebSocket> socket;
+    bool connected = false;
+    int64_t last_connect_ms = 0;
+    int64_t last_ping_ms = 0;
+    int64_t last_warn_ms = 0;
+};
+
+void WarnThrottled(LinkRuntime &runtime, const char *message) {
+    int64_t now = esp_log_timestamp();
+    if (now - runtime.last_warn_ms < 30000) {
+        return;
+    }
+    runtime.last_warn_ms = now;
+    ESP_LOGW(TAG, "%s", message);
+}
+
+void ConnectOnce(LinkRuntime &runtime, const LinkConfig &config) {
+    auto network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        WarnThrottled(runtime, "network unavailable");
+        return;
+    }
+    auto socket = network->CreateWebSocket(1);
+    if (socket == nullptr) {
+        WarnThrottled(runtime, "create websocket failed");
+        return;
+    }
+    const std::string mac = DeviceMac();
+    socket->SetHeader("X-Linx-Device-Id", mac.c_str());
+    socket->SetReceiveBufferSize(4096);
+
+    socket->OnData([&runtime](const char *data, size_t len, bool binary) {
+        if (binary || data == nullptr || len == 0) {
+            return;
+        }
+        // 服务端推的就是一帧 HUD JSON，解析与拉取通道完全一致
+        battle_pull_apply_json(data, len);
+    });
+    socket->OnDisconnected([&runtime]() {
+        runtime.connected = false;
+        ESP_LOGW(TAG, "link disconnected");
+    });
+    socket->OnError([&runtime](int error) {
+        runtime.connected = false;
+        ESP_LOGW(TAG, "link error: %d", error);
+    });
+
+    const std::string url = WithDevice(config.url);
+    ESP_LOGI(TAG, "link url -> %s", url.c_str());
+    if (socket->Connect(url.c_str())) {
+        runtime.connected = true;
+        runtime.last_ping_ms = esp_log_timestamp();
+        ESP_LOGI(TAG, "link connected");
+    } else {
+        runtime.last_connect_ms = esp_log_timestamp();
+        WarnThrottled(runtime, "link connect failed");
+    }
+    runtime.socket = std::move(socket);
+}
+
+void LinkTask(void *) {
+    LinkRuntime runtime;
+    for (;;) {
+        const LinkConfig config = LoadConfig();
+        const int64_t now = esp_log_timestamp();
+
+        if (!config.enabled || config.url.empty()) {
+            if (runtime.socket) {
+                runtime.socket->Close();
+                runtime.socket.reset();
+                runtime.connected = false;
+            }
+            vTaskDelay(pdMS_TO_TICKS(2000));
+            continue;
+        }
+        if (!NetworkReady()) {
+            vTaskDelay(pdMS_TO_TICKS(kWaitNetworkMs));
+            continue;
+        }
+        if (!runtime.connected) {
+            if (runtime.socket == nullptr || now - runtime.last_connect_ms >= kRetryMs) {
+                runtime.last_connect_ms = now;
+                ConnectOnce(runtime, config);
+            }
+        } else if (now - runtime.last_ping_ms >= kPingMs) {
+            runtime.last_ping_ms = now;
+            if (runtime.socket) {
+                runtime.socket->Ping();
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(kTickMs));
+    }
+}
+}  // namespace
+
+bool battle_link_configure(const char *url, bool enabled, char *out, size_t out_len) {
+    if (url == nullptr || url[0] == '\0') {
+        return false;
+    }
+    if (std::strncmp(url, "ws://", 5) != 0 && std::strncmp(url, "wss://", 6) != 0) {
+        return false;
+    }
+    const std::string final_url = WithDevice(url);
+    if (!SaveConfig(final_url, enabled)) {
+        return false;
+    }
+    if (out != nullptr && out_len > 0) {
+        std::snprintf(out, out_len, "%s", final_url.c_str());
+    }
+    // 两条通道同时开只会重复下发，启用推送时顺手关掉拉取
+    if (enabled) {
+        battle_pull_configure(nullptr, false, nullptr, 0);
+    }
+    ESP_LOGI(TAG, "link configured: %s (enabled=%d)", final_url.c_str(), enabled);
+    return true;
+}
+
+bool battle_link_enabled(void) {
+    return LoadConfig().enabled;
+}
+
+void battle_link_start(void) {
+    BaseType_t ok = xTaskCreate(LinkTask, "battle_link", 8192, nullptr, 3, nullptr);
+    if (ok != pdPASS) {
+        ESP_LOGE(TAG, "failed to create link task");
+        return;
+    }
+    ESP_LOGI(TAG, "link task started, heap=%u", static_cast<unsigned>(esp_get_free_heap_size()));
+}
