# 服务监听端口（默认 8000）
PORT=8000
# 监听地址，容器内一般用 0.0.0.0
HOST=0.0.0.0
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 对局空闲过期时间（秒），超时后内存中的对局会被清理
BATTLE_TTL_SECONDS=1800
# 是否暴露 /debug/* 调试端点（生产环境建议 false）
ENABLE_DEBUG_ENDPOINTS=true
# Command Code API Key：配了才启用命令路由、JEV 对手决策与规则外问答
# 不配时：规则认不出的句子按没听出来处理，对手只走本地决策，规则外问题回固定话术
COMMAND_CODE_API_KEY=
# Provider 根地址，换代理、自建网关或换厂商时覆盖
# COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
# 决策模型与语言模型的路径，默认就是官方那两条；换厂商时一起改。
# 例：改用 OpenRouter 时 base 填 https://openrouter.ai/api、决策路径 /alpha/decisions、
# 语言路径 /v1/chat/completions、决策模型 typesafe/jev-1.13
# COMMAND_CODE_DECISION_PATH=/systemone
# COMMAND_CODE_CHAT_PATH=/chat/completions
# JEV 决策模型名（命令路由与对手决策共用）
COMMAND_CODE_DECISION_MODEL=typesafe/jev
# 规则外问答的语言模型
COMMAND_CODE_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# 语言模型的推理开关：off / low。推理模型（例如 OpenRouter 的 qwen/qwen3.7-flash）
# 不关掉思考会把 token 全花在思考上，正文是空的。
# COMMAND_CODE_CHAT_REASONING=off
# 问答超时（毫秒），超时回固定话术
# CHAT_TIMEOUT_MS=3000
# 命令路由超时（毫秒），超时按没认出来处理
# 对手 AI：jev（默认，走 JEV 决策）或 local（只用本地决策模型）
# ENEMY_AI=jev
# 对手单次决策超时（毫秒），超时回退本地
# ENEMY_TIMEOUT_MS=1200
ROUTER_TIMEOUT_MS=1500
# 两台设备靠很近时的座位归属：off（默认，按轮次仲裁）| strict（句子要带「红方/蓝方」）
# ATTRIBUTION_MODE=off
# 后台监控页口令：不配时 /admin 对所有人可见，只适合演示环境
# ADMIN_TOKEN=
