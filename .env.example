# 服务监听端口（默认 8000）
PORT=8000
# 监听地址，容器内一般用 0.0.0.0
HOST=0.0.0.0
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 对局空闲过期时间（秒），超时后内存中的对局会被清理
BATTLE_TTL_SECONDS=1800
# 是否暴露 /debug/* 调试端点（生产环境建议 false）
ENABLE_DEBUG_ENDPOINTS=true
# OpenRouter API Key，配了才启用 JEV 意图模型（不配则只用规则匹配）
OPENROUTER_API_KEY=
# 意图模型名
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# 意图模型超时（毫秒），超时按没认出来处理
INTENT_TIMEOUT_MS=1500
