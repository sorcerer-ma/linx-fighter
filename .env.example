# 服务监听端口（默认 8000）
PORT=8000
# 监听地址，容器内一般用 0.0.0.0
HOST=0.0.0.0
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 对局空闲过期时间（秒），超时后内存中的对局会被清理
BATTLE_TTL_SECONDS=1800
# 是否暴露 /debug/* 调试端点（生产环境建议 false）
ENABLE_DEBUG_ENDPOINTS=true

# 模型 provider：命令路由/对手决策与规则外问答独立配置。
# 不填决策密钥时：规则认不出的句子按没听出来处理，对手只走本地决策，
# 不填聊天密钥时规则外问题回固定话术。密钥只放运行环境，不进仓库。
# 独立 provider；仅配置一方密钥时只启用对应能力。
DECISION_API_KEY=
DECISION_BASE_URL=https://api.modelink.ai/v1
CHAT_API_KEY=
CHAT_BASE_URL=https://api.qnaigc.com/v1
# 显式设置专用地址时必须填写对应专用密钥，不回退 API_KEY。
# 旧配置：未设置专用地址时，缺少的专用密钥可回退 API_KEY。
# API_KEY=
# BASE_URL=https://api.modelink.ai/v1
# 决策模型与语言模型
DECISION_MODEL=typesafe/jev-1.14
CHAT_MODEL=deepseek/deepseek-v4-flash
# 网关路径，默认就是这两条；换网关时一起改
# DECISION_PATH=/systemone
# CHAT_PATH=/chat/completions
# 推理开关：off / low。推理模型不关掉思考会把 token 全花在思考上，正文是空的。
CHAT_REASONING=off
# 问答超时（毫秒），超时回固定话术
# CHAT_TIMEOUT_MS=6000
# 命令路由超时（毫秒），超时按没认出来处理
# ROUTER_TIMEOUT_MS=2000
# 对手 AI：jev（默认，走决策模型）或 local（只用本地决策模型）
# ENEMY_AI=jev
# 对手单次决策超时（毫秒），超时回退本地
# ENEMY_TIMEOUT_MS=2000

# 两台设备靠很近时的座位归属：off（默认，按轮次仲裁）| strict（句子要带「红方/蓝方」）
# ATTRIBUTION_MODE=off
# 后台监控页口令：不配时 /admin 对所有人可见，只适合演示环境
# ADMIN_TOKEN=

# 沙箱模拟平台Agent；已确认的非秘密模型参数；密钥由用户本地填写，不继承游戏服务密钥
SANDBOX_AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
SANDBOX_AGENT_BASE_URL=https://api.qnaigc.com/v1
SANDBOX_AGENT_API_KEY=
# 提示词单源：config/linx-agent-prompt.md；启动读取一次，不含密钥

# 沙箱语音：默认浏览器，doubao 需独立语音服务授权与本地安全密钥。
SANDBOX_ASR_MODE=browser
SANDBOX_TTS_MODE=browser
# SANDBOX_SPEECH_API_KEY=请在本地忽略配置填写，不提交
SANDBOX_TTS_RESOURCE=seed-tts-2.0
SANDBOX_TTS_SPEAKER=zh_female_cancan_uranus_bigtts
# 可选固定本机18391桥接；启用时由该服务独立加载凭据。
# SANDBOX_TTS_BRIDGE=local

# 个体名与音色/声纹身份无关；不填只自称我。
# SANDBOX_COMPANION_NAME=小喵
