# 共鸣：闻声对决 —— 手机沙箱运行配置样例
# 安装：cp deploy/linx-sandbox.env.example /etc/linx-sandbox.env && chmod 600 /etc/linx-sandbox.env
# 改完重启：systemctl restart linx-sandbox

# 只监听回环，由 nginx 反代；要直接对外可改 0.0.0.0。示例端口 10660 要换成网关实际映射的公网端口。
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8100
SANDBOX_UPSTREAM=http://127.0.0.1:8000
SANDBOX_AGENT_ID=linx-sandbox
SANDBOX_DISPLAY=screen
# 页面状态流走沙箱的同源代理：公网只开一个 Web 端口，游戏服务的 8000 不对外。
SANDBOX_EVENTS_URL=/api/events
LOG_LEVEL=info

# 可选：本机语音合成桥（127.0.0.1:18391）。不启用时页面走浏览器 TTS。
# SANDBOX_TTS_BRIDGE=local

# 可选：沙箱自己起 HTTPS。手机浏览器只在安全上下文里给麦克风；
# 只点按钮时 HTTP 也能玩。证书路径必须存在且可读。
# SANDBOX_TLS_CERT=/etc/linx-sandbox/fullchain.pem
# SANDBOX_TLS_KEY=/etc/linx-sandbox/privkey.pem

# 可选：让沙箱转发层带表达模型；不填则使用工具原文
# SANDBOX_AGENT_MODEL=
# SANDBOX_AGENT_BASE_URL=
# SANDBOX_AGENT_API_KEY=
