# 共鸣：闻声对决 —— 运行配置样例
# 安装：cp deploy/linx-fighter.env.example /etc/linx-fighter.env && chmod 600 /etc/linx-fighter.env
# 改完重启：systemctl restart linx-fighter

NODE_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# 对局与房间内存态保留时长（秒）
BATTLE_TTL_SECONDS=1800
# 生产默认关闭 /debug/* 调试端点
ENABLE_DEBUG_ENDPOINTS=false

# 命令路由、对手模型与规则外问答共用一条模型网关 Key。
# 不填 API_KEY 时：规则认不出的句子按没听出来处理，对手走本地决策，
# 规则外问题回固定话术。密钥只写在实际部署的 /etc/linx-fighter.env 里，不进仓库。
BASE_URL=https://api.modelink.ai/v1
API_KEY=
DECISION_MODEL=typesafe/jev-1.14
CHAT_MODEL=deepseek/deepseek-v4-flash
# 网关路径，默认就是这两条；换网关时一起改
# DECISION_PATH=/systemone
# CHAT_PATH=/chat/completions
# 推理模型要关掉思考，否则只输出思考、正文为空
CHAT_REASONING=off

# 两台设备靠很近时的座位归属：off（默认，按轮次仲裁）| strict（句子要带「红方/蓝方」）
# ATTRIBUTION_MODE=off
# 后台监控页 /admin。留空即公开：拿到地址的人都能看到房间号，
# 而房间号同时是加入凭证，演示环境之外务必配上口令。
# ADMIN_TOKEN=
