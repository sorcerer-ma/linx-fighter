# 共鸣：闻声对决 —— 运行配置样例
# 安装：cp deploy/linx-fighter.env.example /etc/linx-fighter.env && chmod 600 /etc/linx-fighter.env
# 改完重启：systemctl restart linx-fighter

NODE_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# 对局与房间内存态保留时长（秒）
BATTLE_TTL_SECONDS=1800
# 生产默认关闭 /debug/* 调试端点
ENABLE_DEBUG_ENDPOINTS=false

# 意图模型与对手模型。不填时：意图只走规则匹配，对手走本地决策
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=typesafe/jev-1.13
