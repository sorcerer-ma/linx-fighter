# 共鸣：闻声对决 —— 运行配置样例
# 安装：cp deploy/linx-fighter.env.example /etc/linx-fighter.env && chmod 600 /etc/linx-fighter.env
# 改完重启：systemctl restart linx-fighter

NODE_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# 对局与房间内存态保留时长（秒）
BATTLE_TTL_SECONDS=1800
# 生产默认关闭 /debug/* 调试端点
ENABLE_DEBUG_ENDPOINTS=false

# 决策模型、对手模型与规则外问答共用一条 Command Code Key。
# 不填时：意图只走规则匹配，对手走本地决策，规则外问题回固定话术
# COMMAND_CODE_API_KEY=
# COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
# COMMAND_CODE_DECISION_MODEL=typesafe/jev
# COMMAND_CODE_CHAT_MODEL=deepseek/deepseek-v4.1-flash
